# AutoTender-VN — biến môi trường cấu hình
# Copy file này thành .env và điền giá trị thật (đã gitignore, không commit).
#
# Cách dùng:
#   cp .env.example .env
#   # Sửa giá trị trong .env
#   streamlit run app/main.py

# ============================================================
# LLM — Claude API (Anthropic)
# Lấy key tại: https://console.anthropic.com/
# ============================================================
ANTHROPIC_API_KEY=sk-ant-...

# ============================================================
# Vector DB — Qdrant
# Mặc định trỏ vào Qdrant chạy qua docker-compose.yml
# Thay đổi nếu Qdrant chạy trên máy khác hoặc port khác.
# ============================================================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=legal_chunks

# ============================================================
# Embedding model (tuỳ chọn — ghi đè giá trị trong configs/app.yaml)
# Mặc định: deepx_v1 (dxtech-asia/deepx-embedding-v1)
# Các lựa chọn khác: vi_bi_encoder, multilingual_minilm, bge_m3
# ============================================================
# EMBEDDING_MODEL_KEY=deepx_v1

# ============================================================
# Log format (tuỳ chọn — dùng khi tích hợp với ELK/Loki)
# ============================================================
# AUTOTENDER_LOG_FORMAT=json
