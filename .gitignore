.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# checkpoints tải từ Colab — quá lớn để commit
models/*
!models/.gitkeep

# dữ liệu thu thập/sinh ra — chỉ commit data/samples/
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# index RAG (FAISS) — build lại bằng scripts/build_legal_index.py, không commit binary
data/index/*
reports/*
!reports/*.md
reports/*.json
reports/figures/*
!reports/figures/.gitkeep

*.db
.streamlit/secrets.toml
.env
